# Contoh konfigurasi. Salin ke .env, isi, jangan pernah commit .env.
#
#   cp .env.example .env
#
# Nilai boolean dibaca sebagai os.getenv(...).strip().lower() == "true", jadi
# HANYA "true" (spasi/uppercase boleh) yang aktif — "1", "yes", "on" semuanya
# berarti false. Baris yang kamu biarkan kosong/komentar berperilaku sama dengan
# tidak men-set-nya.
#
# Dokumen terkait: docs/CONFIGURATION.md (28 env var + parameter per mode),
#                  docs/SECURITY.md (scope kunci, rotasi).

# ── Mode ────────────────────────────────────────────────────────────────
# true = nol panggilan TAPI. Ini default yang sengaja.
PAPER_TRADING=true
# ALPHA adalah default; INSANE_MODE=true menang atas ALPHA.
ALPHA_MODE=true
INSANE_MODE=false

# ── Kredensial Indodax ──────────────────────────────────────────────────
# TAPI v2 (utama untuk trading). Buat di dashboard Indodax, scope trading saja.
INDODAX_V2_API_KEY=
INDODAX_V2_SECRET_KEY=
# Kunci legacy. MASIH WAJIB walau trading sudah v2: deadman switch dan token
# private-WS hanya ada di endpoint v1 (config.py:113-115).
INDODAX_API_KEY=
INDODAX_SECRET_KEY=
# Basis URL v2; hanya diubah kalau Indodax pindah endpoint.
#INDODAX_TAPI_V2_URL=https://api.indodax.com
# auto = pakai v2 kalau KEDUA kunci v2 terisi; paksa dengan v1 / v2.
#TAPI_VERSION=auto

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI optimizer (opsional) ─────────────────────────────────────────────
# Kosong = optimizer nonaktif, bot tetap jalan dengan parameter terakhir.
DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#DEEPSEEK_MODEL=deepseek-v4-flash
# Terapkan usulan parameter tanpa konfirmasi. true = tanpa rem.
AI_OPTIMIZER_AUTO_APPLY=true

# ── Modal & risiko ──────────────────────────────────────────────────────
# Saldo awal paper; juga dasar DAILY_LOSS_FLOOR dan compound cap.
PLAY_CAPITAL_IDR=300000
# Kalau di-set, MENIMPA nilai dari profil mode (ALPHA default-nya 999999).
#MAX_DAILY_TRADES=
# Pair untuk deadman switch.
PAIR=btc_idr
# true = entry pakai limit maker (+slippage 0,001) alih-alih taker.
MAKER_FIRST=false

# ── Scan & data ─────────────────────────────────────────────────────────
MAX_SCAN_PAIRS=40
MIN_24H_VOLUME_IDR=500000000
OHLCV_FETCH_CONCURRENCY=15
# Token publik market WS bawaan Indodax. Override hanya kalau Indodax ganti.
#WS_MARKET_TOKEN=

# ── Storage ─────────────────────────────────────────────────────────────
# WAJIB diisi di Railway. Direktori untuk trades.db, state.json, dca_*, grid_*.
# Fallback kalau kosong: DATA_DIR -> /data -> direktori repo.
STATE_DIR=
#DATA_DIR=            # alias lama STATE_DIR, tetap dibaca

# ── Sekali jalan ────────────────────────────────────────────────────────
# Set nilai apa pun untuk mereset flag daily-loss dari state.json saat boot.
# Hanya dipakai ketika start, lalu dihapus maknanya.
#CLEAR_LOSS_HOLD=1

# ── Dibaca tapi TIDAK berpengaruh (jangan habiskan waktu di sini) ───────
# Ada di config.py lewat os.getenv, tapi tidak ada kode yang memakai hasilnya.
# Lihat docs/KNOWN_ISSUES.md#knob-mati
#SENTRY_DSN=            # sentry-sdk ada di requirements, tidak pernah di-import
#AI_OPTIMIZER_INTERVAL_CYCLES=50   # cadensi asli: poll 15s, >=50 sell baru atau >=7 hari
